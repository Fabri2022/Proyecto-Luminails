# Copiá este archivo como .env.local y completá los valores.
# NUNCA subas .env.local a GitHub ni lo pegues en un chat.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # SECRETA: solo en el servidor / Vercel

# Google AI Studio (Gemini) para MIA
GEMINI_API_KEY=                   # SECRETA (aistudio.google.com → Get API key)
# GEMINI_MODEL=gemini-3.8-flash   # opcional: cambia el modelo sin tocar el código

# Mercado Pago → credenciales de PRUEBA (Tus integraciones → Credenciales de prueba; empiezan con TEST- o APP_USR-)
MP_ACCESS_TOKEN=                  # SECRETA
NEXT_PUBLIC_MP_PUBLIC_KEY=

# URL pública del sitio (en Vercel: https://TU-PROYECTO.vercel.app)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
